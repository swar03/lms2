// schema.prisma - Production Grade LMS Schema
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  MANAGER
  STUDENT
}

enum UserStatus {
  PENDING
  APPROVED
  REJECTED
  ABANDONED
}

enum ApprovalStatus {
  APPROVED
  REJECTED
  PENDING
}

enum NotificationType {
  NEW_USER
  APPROVAL
  CERTIFICATE
  SYSTEM
}

model User {
  id            String        @id @default(uuid())
  email         String        @unique
  passwordHash  String?
  fullName      String?
  mobile        String?
  city          String?
  organization  String?
  linkedin      String?
  roles         Role[]        @default([])
  status        UserStatus    @default(PENDING)
  emailVerified Boolean       @default(false)
  verificationToken String?
  emailOTP      String?
  otpExpiry     DateTime?
  approvedById  String?       // FK to User who approved
  approvalNote  String?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  deletedAt     DateTime?
  
  // Relations
  profile       Profile?
  admin         Admin?
  manager       Manager?
  approvals     Approval[]    @relation("userApprovals")
  actorApprovals Approval[]   @relation("actorApprovals")
  notifications Notification[]
  auditLogs     AuditLog[]    @relation("actorLogs")
  submissions   Submission[]
  certificates  Certificate[]
  
  @@index([status])
  @@index([createdAt])
}

model Profile {
  id             String   @id @default(uuid())
  userId         String   @unique
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  occupation     String?
  country        String?
  whatsapp       String?
  dateOfBirth    DateTime?
  gender         String?
  address        String?
  education      String?
  experience     String?
  skills         String?  // JSON string
  certifications String?  // JSON string for certifications
  profileComplete Boolean @default(false)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

model Admin {
  id        String   @id @default(uuid())
  userId    String   @unique
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
}

model Manager {
  id        String   @id @default(uuid())
  userId    String   @unique
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
}

model Approval {
  id         String         @id @default(uuid())
  userId     String
  user       User           @relation("userApprovals", fields: [userId], references: [id], onDelete: Cascade)
  actorId    String?
  actor      User?          @relation("actorApprovals", fields: [actorId], references: [id])
  note       String?
  status     ApprovalStatus @default(PENDING)
  ipAddress  String?
  createdAt  DateTime       @default(now())
  
  @@index([userId])
  @@index([status])
}

model Course {
  id          String    @id @default(uuid())
  title       String
  description String?
  modules     Module[]
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?
  
  @@unique([title])
}

model Module {
  id          String    @id @default(uuid())
  courseId    String
  course      Course    @relation(fields: [courseId], references: [id], onDelete: Cascade)
  title       String
  description String?
  order       Int       @default(0)
  lectures    Lecture[]
  certificates Certificate[]
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?
  
  @@index([courseId])
  @@unique([courseId, title])
}

model Lecture {
  id          String    @id @default(uuid())
  moduleId    String
  module      Module    @relation(fields: [moduleId], references: [id], onDelete: Cascade)
  title       String
  description String?
  order       Int       @default(0)
  videoUrl    String
  quiz        Quiz?
  assignment  Assignment?
  submissions Submission[]
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?
  
  @@index([moduleId])
  @@unique([moduleId, title])
}

model Assignment {
  id          String     @id @default(uuid())
  lectureId   String     @unique
  lecture     Lecture    @relation(fields: [lectureId], references: [id], onDelete: Cascade)
  title       String
  instructions String?
  submissions Submission[]
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
  deletedAt   DateTime?
}

model Quiz {
  id         String     @id @default(uuid())
  lectureId  String     @unique
  lecture    Lecture    @relation(fields: [lectureId], references: [id], onDelete: Cascade)
  title      String
  questions  Question[]
  submissions Submission[]
  createdAt  DateTime   @default(now())
  updatedAt  DateTime   @updatedAt
  deletedAt  DateTime?
}

model Question {
  id        String    @id @default(uuid())
  quizId    String
  quiz      Quiz      @relation(fields: [quizId], references: [id], onDelete: Cascade)
  text      String
  choices   Choice[]
  order     Int       @default(0)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  
  @@index([quizId])
}

model Choice {
  id         String   @id @default(uuid())
  questionId String
  question   Question @relation(fields: [questionId], references: [id], onDelete: Cascade)
  text       String
  isCorrect  Boolean  @default(false)
}

model Submission {
  id           String    @id @default(uuid())
  userId       String
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  lectureId    String?
  lecture      Lecture?  @relation(fields: [lectureId], references: [id])
  moduleId     String?
  assignmentId String?
  assignment   Assignment? @relation(fields: [assignmentId], references: [id])
  quizId       String?
  quiz         Quiz?     @relation(fields: [quizId], references: [id])
  assignmentLink String?
  quizAnswers  Json?
  score        Float?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  
  @@index([userId])
  @@index([lectureId])
  @@index([assignmentId])
  @@index([quizId])
  @@unique([userId, assignmentId], name: "user_assignment_unique")
  @@unique([userId, quizId], name: "user_quiz_unique")
}

model Certificate {
  id               String   @id @default(uuid())
  certificateNumber String  @unique @default(uuid())
  userId           String
  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  moduleId         String
  module           Module   @relation(fields: [moduleId], references: [id], onDelete: Cascade)
  s3Url            String
  issuedAt         DateTime @default(now())
}

model Notification {
  id           String           @id @default(uuid())
  recipientId  String
  recipient    User             @relation(fields: [recipientId], references: [id], onDelete: Cascade)
  type         NotificationType
  message      String
  read         Boolean          @default(false)
  createdAt    DateTime         @default(now())
  expiresAt    DateTime?
}

model AuditLog {
  id         String   @id @default(uuid())
  actorId    String?
  actor      User?    @relation("actorLogs", fields: [actorId], references: [id])
  action     String   // e.g., "APPROVE_USER", "DELETE_COURSE", "EXPORT_USERS"
  entityType String?
  entityId   String?
  ip         String?
  createdAt  DateTime @default(now())
}

model SystemConfig {
  id                 Int     @id @default(1)
  autoApproveDays    Int     @default(3)
  paginationLimit    Int     @default(50)
  rateLimitPer15Min  Int     @default(20)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
}
